# Keep the backend Docker build context intentionally small.
# The FastAPI app only needs runtime code, dependencies, latest model bundles,
# and the feature parquet used by DataLoader.

*

!Dockerfile
!requirements.txt

!app/
!app/**

!data/
!data/processed/
!data/processed/all_stocks_features.parquet
!data/processed/fold_config.json
!data/processed/models/
!data/processed/models/model_latest.pkl
!data/processed/models/model_latest_sell.pkl
!data/processed/models/model_latest_rf.pkl
!data/processed/models/model_latest_rf_sell.pkl

# Explicitly keep generated research/training artifacts and non-backend code out.
data/raw/
data/processed/report/
outputs/
frontend/
src/
scrapper/
automation/
docs/
.git/
.github/
venv/
node_modules/
pre-purge.bundle

# evaluation_repository.py reads these two report/output tables to serve
# GET /api/model-performance (the Trust page) — carve them back out of the
# blanket excludes above, without pulling in the report PNGs or output logs.
!data/processed/report/summary_table.csv
!data/processed/report/summary_table_rf.csv
!outputs/strategy_metrics.csv
!outputs/strategy_metrics_rf.csv
