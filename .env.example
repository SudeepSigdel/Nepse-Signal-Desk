# ════════════════════════════════════════════════════════════
# NEPSE AI Signals — Environment Configuration
# Copy this to .env and fill in your values
# ════════════════════════════════════════════════════════════

# ─── Server Settings ───────────────────────────────────────
ENV=development
# production | staging | development
DEBUG=true
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR | CRITICAL

# ─── Paths ─────────────────────────────────────────────────
PROJECT_ROOT=/path/to/Final Year Project
# Absolute or relative to PROJECT_ROOT:
DATA_PROCESSED_DIR=data/processed
MODEL_DIR=data/processed/models
RAW_DATA_DIR=data/raw

# ─── API Settings ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=NEPSE AI Signals
API_VERSION=0.1.0

# ─── CORS (Frontend URLs) ──────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://yourdomain.com

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ─── Database (for Beta/Production) ────────────────────────
# Leave blank for MVP (no user management yet)
DATABASE_URL=postgresql://user:password@localhost:5432/nepse_signals
# Examples:
# PostgreSQL: postgresql://user:pass@localhost:5432/nepse_signals
# SQLite: sqlite:///./nepse_signals.db

# ─── Security (Production) ─────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ─── Email (for Alerts, Beta+) ─────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@nepse-signals.com

# ─── External Services ─────────────────────────────────────
SENTRY_DSN=
# Optional: for error tracking in production

# ─── Data Scraping ─────────────────────────────────────────
SCRAPER_SOURCE=sharesansar
# auto | sharesansar | merolagani
SCRAPER_DELAY=0.2
# Delay in seconds between stock requests

# ─── Monitoring ────────────────────────────────────────────
MONITORING_ENABLED=false
METRICS_PORT=9090

# ─── Feature Flags ─────────────────────────────────────────
ENABLE_SIGNAL_HISTORY=false
ENABLE_USER_ALERTS=false
ENABLE_EXPLAINABILITY=false
