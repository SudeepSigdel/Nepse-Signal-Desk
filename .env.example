# ════════════════════════════════════════════════════════════
# NEPSE AI Signals — Environment Configuration
# Copy this to .env and fill in your values
# ════════════════════════════════════════════════════════════

# ─── Server Settings ───────────────────────────────────────
ENV=development
# production | staging | development
DEBUG=true
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR | CRITICAL

# ─── Paths ─────────────────────────────────────────────────
PROJECT_ROOT=/path/to/Final Year Project
# Absolute or relative to PROJECT_ROOT:
DATA_PROCESSED_DIR=data/processed
MODEL_DIR=data/processed/models
RAW_DATA_DIR=data/raw

# ─── API Settings ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=NEPSE AI Signals
API_VERSION=0.1.0

# ─── CORS (Frontend URLs) ──────────────────────────────────
# Comma-separated list of allowed origins that may call this API.
# If the frontend lives on its own (sub)domain — e.g. app.example.com calling
# api.example.com — list the FRONTEND's origin(s) here, not the backend's own.
# Startup fails fast if ENV=production and this is still "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://yourdomain.com

# ─── Security (Production) ─────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 7 days

# ─── Database (user accounts, watchlist, positions) ────────
DATABASE_URL=postgresql://user:password@host/dbname
# e.g. a free Neon or Supabase Postgres instance

# ─── Google OAuth (optional; email/password works without it) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be this backend's own domain + /api/auth/google/callback — e.g. if the
# frontend is app.example.com and the API is api.example.com, this is
# https://api.example.com/api/auth/google/callback, NOT the frontend's domain.
# Must also be registered exactly (scheme, host, path) under "Authorized
# redirect URIs" in the Google Cloud Console OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Where to redirect the browser after a successful Google login (the frontend's
# own domain/port — this one IS the frontend, unlike GOOGLE_REDIRECT_URI above).
FRONTEND_URL=http://localhost:3000

# ─── Data Scraping ─────────────────────────────────────────
SCRAPER_SOURCE=sharesansar
# auto | sharesansar | merolagani
SCRAPER_DELAY=0.2
# Delay in seconds between stock requests
NEPSE_SCRAPER_START_DATE=2020-01-01
# Earliest date the scraper backfills from when no existing data is present

# ─── ML Model Family ────────────────────────────────────────
# Which trained model artifacts the API serves and src/ pipeline scripts train.
MODEL_FAMILY=random_forest
# random_forest | xgboost
